# ─── Clerk (Auth) ───────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ─── API URL ────────────────────────────────────────────────────
# Obrigatório no celular físico (Expo Go): IP da máquina onde a API roda
# Exemplo: EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
#
# Android Emulator: http://10.0.2.2:3000
# iOS Simulator:    http://127.0.0.1:3000
# EXPO_PUBLIC_API_URL=

# ─── Dev Bypass (somente dev local) ────────────────────────────
# Token deve bater com DEV_BYPASS_TOKEN da API
EXPO_PUBLIC_DEV_BYPASS_TOKEN=
EXPO_PUBLIC_DEV_BYPASS_USER_ID=dev-user-local

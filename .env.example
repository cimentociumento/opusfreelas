# ── Banco (Supabase) ──────────────────────────
DATABASE_URL=postgresql://postgres:[senha]@db.[projeto].supabase.co:5432/postgres
SUPABASE_URL=https://[projeto].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Clerk ─────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Opcional: origens autorizadas (vírgula). Deixe vazio em dev local.
# CLERK_AUTHORIZED_PARTIES=opusfreelas://,exp://192.168.0.10:8081

# ── Expo (prefixo EXPO_PUBLIC_ expõe ao bundle mobile) ──
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Celular físico com Expo Go: use o IP da sua máquina na rede local
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# ── API ───────────────────────────────────────
PORT=3000
NODE_ENV=development
